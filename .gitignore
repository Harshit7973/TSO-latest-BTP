# output files — keep BTP results but exclude general logs
/logs
/wandb

# BTP — exclude heavy/auto-generated files
btp/outputs/dqn/tensorboard/
btp/models/dqn_checkpoints/
btp/outputs/dqn/*_monitor.monitor.csv

# Keep everything else in btp/ (models, CSVs, plots)
!btp/
!btp/**

# Ignore heavy replay buffers and tensorboard logs in sem-2
sem-2/**/dqn_v2_replay_buffer.pkl
sem-2/**/logs/tensorboard/

